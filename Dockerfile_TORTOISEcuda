ARG TAG_TORTOISE=26.9.3

FROM pennlinc/qsiprep-drbuddi:${TAG_TORTOISE} AS tortoise_cpu
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04 AS builder
ARG MAX_JOBS=2
ENV CMAKE_BUILD_PARALLEL_LEVEL=${MAX_JOBS}

# Compile against precisely the ITK installation used by the CPU build.
COPY --from=tortoise_cpu /opt/tortoise-itk /opt/tortoise-itk

RUN apt update && apt full-upgrade -y && \
  apt install --no-install-recommends -y \
    software-properties-common \
    zlib1g-dev \
    wget \
    git \
    build-essential \
    libeigen3-dev \
    fftw3 \
    libfftw3-dev \
    gnupg \
    ca-certificates \
    apt-transport-https \
    cmake \
    cmake-data \
    patchelf \
    libboost-dev \
    libboost-iostreams-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-regex-dev && \
  apt-get clean && rm -rf /var/lib/apt/lists/* /var/tmp/*


# Source is PennLINC's TORTOISE fork, not QMICodeBase/TORTOISEV4 upstream.
# Its `upstream-port` branch is f559360 -- the newest upstream commit still
# targeting ITK 5.3 -- plus the seven
# post-cutoff upstream commits cherry-picked. It carries the qsiprep-side
# additions that stock TORTOISE rejects: --epi_working_res,
# --DRBUDDI_synth_shell_bval and the --ncores fixes.
#
# Keep TORTOISE_SHA in sync with Dockerfile_TORTOISE.
ARG TORTOISE_REPO=https://github.com/PennLINC/qsiprep_TORTOISE.git
ARG TORTOISE_SHA=6108a894203d60b6cb9188107e5183b17af95b4a
#
# The clone must land on /src/TORTOISEV4. CMAKE_RUNTIME_OUTPUT_DIRECTORY is
# ${CMAKE_BINARY_DIR}/../bin, so configuring inside <root>/TORTOISEV4 writes the
# binaries to <root>/bin -- and qsiprep's Dockerfile.base copies
# /src/TORTOISEV4/bin/*cuda out of this image.
#
RUN \
  mkdir -p /src \
  && git clone ${TORTOISE_REPO} /src/TORTOISEV4 \
  && cd /src/TORTOISEV4 \
  && git checkout ${TORTOISE_SHA} \
  && cd TORTOISEV4 \
  && sed -i '/BrukerBmatToTORTOISEBMTXT/d' CMakeLists.txt \
  && sed -i '/JoanahRegisterAlongAxes/d' CMakeLists.txt \
  && sed -i -E '/^[[:space:]]*(add_executable|target_include_directories|target_link_libraries|target_compile_definitions)\(DRTAMAS/d' CMakeLists.txt \
  && cmake . \
      -DUSECUDA=1 \
      -DQSIPREP=1 \
      -DITK_DIR=/opt/tortoise-itk/lib/cmake/ITK-5.3 \
      -DISDEBUG=0 \
      && \
    cmake --build . --target TORTOISEProcess_cuda DRBUDDI_cuda \
  && find /src/TORTOISEV4/bin -maxdepth 1 -type f -name '*cuda' -executable -exec \
      patchelf --force-rpath --set-rpath '$ORIGIN/lib/itk' {} \;

FROM tortoise_cpu
COPY --from=builder /src/TORTOISEV4/bin/*cuda /src/TORTOISEV4/bin/
RUN ldd /src/TORTOISEV4/bin/TORTOISEProcess_cuda \
      | grep -q '/src/TORTOISEV4/bin/lib/itk/libITK' \
    && ! ldd /src/TORTOISEV4/bin/TORTOISEProcess_cuda | grep -q 'not found' \
    && ! ldd /src/TORTOISEV4/bin/TORTOISEProcess_cuda | grep -q '/opt/ants'

CMD ["/bin/bash"]
