ARG TAG_ANTS

FROM nvidia/cuda:12.2.2-devel-ubuntu22.04 as base
FROM pennlinc/qsiprep-ants:${TAG_ANTS} as ants_source
FROM base as builder

# Copy ANTs build directory from the ANTs image
COPY --from=ants_source /tmp/ants /tmp/ants

RUN apt update && apt full-upgrade -y && \
  apt install --no-install-recommends -y \
    software-properties-common \
    zlib1g-dev \
    wget \
    git \
    build-essential \
    libeigen3-dev \
    fftw3 \
    libfftw3-dev \
    gnupg \
    ca-certificates \
    apt-transport-https \
    cmake \
    cmake-data \
    libboost-dev \
    libboost-iostreams-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-regex-dev && \
  apt-get clean && rm -rf /var/lib/apt/lists/* /var/tmp/*


# Source is PennLINC's TORTOISE fork, not QMICodeBase/TORTOISEV4 upstream.
# Its `upstream-port` branch is f559360 -- the newest upstream commit still
# targeting the ITK 5.3 that pennlinc/qsiprep-ants ships -- plus the seven
# post-cutoff upstream commits cherry-picked. It carries the qsiprep-side
# additions that stock TORTOISE rejects: --epi_working_res,
# --DRBUDDI_synth_shell_bval and the --ncores fixes.
#
# Keep TORTOISE_SHA in sync with Dockerfile_TORTOISE.
ARG TORTOISE_REPO=https://github.com/PennLINC/qsiprep_TORTOISE.git
ARG TORTOISE_SHA=d3301e5e9a96b16c0ce82760f4198708af81c07e
#
# The clone must land on /src/TORTOISEV4. CMAKE_RUNTIME_OUTPUT_DIRECTORY is
# ${CMAKE_BINARY_DIR}/../bin, so configuring inside <root>/TORTOISEV4 writes the
# binaries to <root>/bin -- and qsiprep's Dockerfile.base copies
# /src/TORTOISEV4/bin/*cuda out of this image.
#
RUN \
  mkdir -p /src \
  && git clone ${TORTOISE_REPO} /src/TORTOISEV4 \
  && cd /src/TORTOISEV4 \
  && git checkout ${TORTOISE_SHA} \
  && cd TORTOISEV4 \
  && sed -i '/BrukerBmatToTORTOISEBMTXT/d' CMakeLists.txt \
  && sed -i '/JoanahRegisterAlongAxes/d' CMakeLists.txt \
  && sed -i -E '/^[[:space:]]*(add_executable|target_include_directories|target_link_libraries|target_compile_definitions)\(DRTAMAS/d' CMakeLists.txt \
  && cmake . \
      -DUSECUDA=1 \
      -DQSIPREP=1 \
      -DITK_DIR=/tmp/ants/build/ITKv5-build \
      -DISDEBUG=0 \
      && \
    make

CMD ["/bin/bash"]
