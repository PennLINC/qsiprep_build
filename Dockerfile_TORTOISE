FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04 AS builder

# TORTOISE supports ITK 5.3. Keep this pin independent of ANTs: TORTOISE only
# links to ITK, and its serialized transforms are consumed by whichever ANTs
# installation the downstream application provides.
ARG ITK_REPO=https://github.com/InsightSoftwareConsortium/ITK.git
ARG ITK_SHA=1fc47c7bec4ee133318c1892b7b745763a17d411
ARG MAX_JOBS=2
ENV CMAKE_BUILD_PARALLEL_LEVEL=${MAX_JOBS}

RUN apt update && apt full-upgrade -y && \
  apt install --no-install-recommends -y \
    software-properties-common \
    zlib1g-dev \
    wget \
    git \
    build-essential \
    libeigen3-dev \
    fftw3 \
    libfftw3-dev \
    gnupg \
    ca-certificates \
    apt-transport-https \
    cmake \
    cmake-data \
    ninja-build \
    patchelf \
    libboost-dev \
    libboost-iostreams-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-regex-dev && \
  apt-get clean && rm -rf /var/lib/apt/lists/* /var/tmp/*

# Build only ITK, rather than using the ITK build tree embedded in the custom
# ANTs image. The installed tree is retained so the CUDA image can compile
# against the exact same headers and libraries.
RUN \
  git clone ${ITK_REPO} /tmp/itk-source \
  && cd /tmp/itk-source \
  && git checkout ${ITK_SHA} \
  && cmake \
      -S /tmp/itk-source \
      -B /tmp/itk-build \
      -GNinja \
      -DBUILD_SHARED_LIBS=ON \
      -DBUILD_TESTING=OFF \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/tortoise-itk \
  && cmake --build /tmp/itk-build \
  && cmake --install /tmp/itk-build \
  && rm -rf /tmp/itk-source /tmp/itk-build


# Source is PennLINC's TORTOISE fork, not QMICodeBase/TORTOISEV4 upstream.
# Its `upstream-port` branch is f559360 -- the newest upstream commit still
# targeting ITK 5.3 -- plus the seven
# post-cutoff upstream commits cherry-picked. It carries the qsiprep-side
# additions that stock TORTOISE rejects: --epi_working_res,
# --DRBUDDI_synth_shell_bval and the --ncores fixes.
ARG TORTOISE_REPO=https://github.com/PennLINC/qsiprep_TORTOISE.git
ARG TORTOISE_SHA=d0a32dcc2c3d401ce7077796b09de68fd00a688f
#
# The clone must land on /src/TORTOISEV4. CMAKE_RUNTIME_OUTPUT_DIRECTORY is
# ${CMAKE_BINARY_DIR}/../bin, so configuring inside <root>/TORTOISEV4 writes the
# binaries to <root>/bin. The private ITK runtime is bundled below that directory
# so consumers that copy /src/TORTOISEV4/bin automatically receive it too.
#
RUN \
  mkdir -p /src \
  && git clone ${TORTOISE_REPO} /src/TORTOISEV4 \
  && cd /src/TORTOISEV4 \
  && git checkout ${TORTOISE_SHA} \
  && cd TORTOISEV4 \
  && sed -i '/BrukerBmatToTORTOISEBMTXT/d' CMakeLists.txt \
  && sed -i '/JoanahRegisterAlongAxes/d' CMakeLists.txt \
  && sed -i -E '/^[[:space:]]*(add_executable|target_include_directories|target_link_libraries|target_compile_definitions)\(DRTAMAS/d' CMakeLists.txt \
  && cmake . \
      -DUSECUDA=0 \
      -DQSIPREP=1 \
      -DITK_DIR=/opt/tortoise-itk/lib/cmake/ITK-5.3 \
      -DISDEBUG=0 \
      && \
    cmake --build . \
  && mkdir -p \
      /src/TORTOISEV4/bin/lib/itk \
      /src/TORTOISEV4/bin/share/licenses/ITK \
  && cp -a /opt/tortoise-itk/lib/*.so* /src/TORTOISEV4/bin/lib/itk/ \
  && cp \
      /opt/tortoise-itk/share/doc/ITK-5.3/LICENSE \
      /opt/tortoise-itk/share/doc/ITK-5.3/NOTICE \
      /src/TORTOISEV4/bin/share/licenses/ITK/ \
  && find /src/TORTOISEV4/bin/lib/itk -type f -name '*.so*' -exec \
      patchelf --force-rpath --set-rpath '$ORIGIN' {} \; \
  && find /src/TORTOISEV4/bin -maxdepth 1 -type f -executable -exec \
      patchelf --force-rpath --set-rpath '$ORIGIN/lib/itk' {} \; \
  && ldd /src/TORTOISEV4/bin/TORTOISEProcess \
      | grep -q '/src/TORTOISEV4/bin/lib/itk/libITK' \
  && ! ldd /src/TORTOISEV4/bin/TORTOISEProcess | grep -q 'not found' \
  && ! ldd /src/TORTOISEV4/bin/TORTOISEProcess | grep -q '/opt/ants'

CMD ["/bin/bash"]
