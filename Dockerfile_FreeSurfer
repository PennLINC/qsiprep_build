FROM freesurfer/freesurfer:8.2.0 AS freesurfer
FROM condaforge/miniforge3:25.3.1-0 AS freesurfer-python

# SynthSeg is a standalone script and only needs this small TensorFlow stack.
RUN mamba create --yes --prefix /opt/freesurfer-synthseg \
      --channel conda-forge \
      python=3.11 \
      tensorflow=2.13.1 \
      surfa=0.6.3 \
      nibabel \
      scipy \
      numpy=1.26 && \
    mamba clean --all --yes && \
    /opt/freesurfer-synthseg/bin/python -c \
      "import nibabel, numpy, scipy, surfa, tensorflow"

# SynthStrip and SynB0 share one CUDA-capable Torch stack. Keep this separate
# from TensorFlow so their CUDA libraries cannot overwrite one another.
RUN mamba create --yes --prefix /opt/freesurfer-torch \
      --channel pytorch \
      --channel nvidia \
      --channel conda-forge \
      python=3.11 \
      pytorch=2.1.2 \
      pytorch-cuda=12.1 \
      surfa=0.6.3 \
      nibabel \
      scipy \
      numpy=1.26 && \
    mamba clean --all --yes && \
    /opt/freesurfer-torch/bin/python -c \
      "import nibabel, numpy, scipy, surfa, torch; assert torch.version.cuda; assert torch.from_numpy(numpy.zeros(1)).shape == (1,)"

FROM ubuntu:22.04
ARG TAG_ANTS

COPY --from=freesurfer \
