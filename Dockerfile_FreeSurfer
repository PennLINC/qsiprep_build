# QSIPrep runs default SynthSeg 2.0 with posterior and QC outputs. Include the
# parcellation model as a low-cost safeguard for direct interface use, but omit
# unrelated SynthMorph, SynthSR, photo, robust, and v1 models.
COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_2.0.h5  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_parc_2.0.h5  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_qc_2.0.h5  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_denoiser_labels_2.0.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_parcellation_labels.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_parcellation_names.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_qc_labels_2.0.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_qc_names_2.0.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_segmentation_labels_2.0.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_segmentation_names_2.0.npy  \
  /usr/local/freesurfer/8.2.0-1/models/synthseg_topological_classes_2.0.npy  \
  /opt/freesurfer/models/

COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/models/synthstrip.1.pt  \
  /usr/local/freesurfer/8.2.0-1/models/synthstrip.nocsf.1.pt  \
  /opt/freesurfer/models/

COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/python/scripts/mri_synthstrip  \
  /opt/freesurfer/bin/mri_synthstrip

COPY --from=freesurfer-python \
  /opt/freesurfer-synthseg \
  /opt/freesurfer-synthseg

COPY --from=freesurfer-python \
  /opt/freesurfer-torch \
  /opt/freesurfer-torch

COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/FreeSurferColorLUT.txt \
  /opt/freesurfer/FreeSurferColorLUT.txt

COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/bin/mri_normalize  \
  /opt/freesurfer/bin/mri_normalize

COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/mni  \
  /opt/freesurfer/mni

COPY --from=freesurfer \
  /lib64/libcrypt* \
  /opt/freesurfer/lib/

COPY --from=freesurfer \
  /usr/local/freesurfer/8.2.0-1/sources.csh \
  /opt/freesurfer/sources.csh

ENV FREESURFER_HOME=/opt/freesurfer
RUN ln -s /opt/freesurfer-synthseg/bin/python /opt/freesurfer/bin/fspython && \
    /opt/freesurfer/bin/fspython -c "import nibabel, scipy, surfa, tensorflow" && \
    /opt/freesurfer-torch/bin/python -c "import nibabel, scipy, surfa, torch; assert torch.version.cuda"
